{
  "schema": 1,
  "appId": "nebula.alpha",
  "provides": [
    { "id": "alpha.time", "kind": "query", "sensitivity": "public", "title": { "fr": "Heure d'Alpha", "en": "Alpha's time" }, "description": { "fr": "Heure locale vue par Alpha." }, "resultSchema": "WidgetV1" },
    { "id": "alpha.secret", "kind": "query", "sensitivity": "private", "title": { "fr": "Solde d'Alpha" }, "description": { "fr": "Une valeur privée d'Alpha." }, "resultSchema": "WidgetV1" },
    { "id": "alpha.status", "kind": "widget", "sensitivity": "private", "title": { "fr": "État d'Alpha" }, "description": { "fr": "Carte de l'accueil du Hub." }, "resultSchema": "WidgetV1", "refreshSeconds": 60 },
    { "id": "alpha.tick", "kind": "event", "sensitivity": "public", "title": { "fr": "Pause d'Alpha" }, "description": { "fr": "Alpha commence une pause." }, "payloadSchema": "BreakStartedV1" },
    { "id": "alpha.alert", "kind": "event", "sensitivity": "private", "title": { "fr": "Alerte d'Alpha" }, "description": { "fr": "Une notification privée d'Alpha." }, "payloadSchema": "NotificationV1" },
