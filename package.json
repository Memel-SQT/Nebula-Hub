{
  "name": "nebula-hub",
  "version": "0.1.0",
  "private": true,
  "author": "Nebula Hub",
  "description": "Nebula Hub launches, installs, updates and connects the Nebula desktop apps, locally and without any account.",
  "license": "MIT",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:build\" \"npm:dev:electron:start\"",
    "dev:renderer": "vite",
    "dev:electron:build": "tsup --watch",
    "dev:electron:start": "wait-on http://127.0.0.1:5173 dist/electron/main.js dist/electron/preload.js && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsup",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "dist:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never --config.directories.output=install/windows",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "catalog:sign": "ts-node --transpile-only -O \"{\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/sign-catalog.ts",
    "catalog:verify": "ts-node --transpile-only -O \"{\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/verify-catalog.ts",
    "link:build": "npm run build --workspace @nebula/link",
    "link:pack": "npm run link:build && node -e \"require('fs').mkdirSync('install/link', { recursive: true })\" && npm pack --workspace @nebula/link --pack-destination install/link",
    "link:demo": "tsup tests/link-harness/demo.ts --format cjs --out-dir dist/link-demo --silent && node dist/link-demo/demo.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "hub.nebula.desktop",
    "productName": "Nebula Hub",
    "copyright": "Copyright (c) 2026 Nebula Hub",
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "Nebula-Hub-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Memel-SQT",
      "repo": "Nebula-Hub"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "catalog",
        "to": "catalog",
        "filter": [
          "nebula-catalog.json",
          "nebula-catalog.json.sig",
          "icons/**",
          "screenshots/**"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.27.7": true
  }
}
